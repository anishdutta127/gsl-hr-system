# GSL HR System — environment variables.
# Copy to .env.local for local dev (.env.local is gitignored).
# Set these in Vercel Project Settings → Environment Variables for production.
# Rotation runbook lives in docs/RUNBOOK.md.

# GitHub Contents API token for the queued-write pattern. Fine-grained PAT
# scoped to this repo, Contents: Read and write. 90-day rotation.
# Loss of this token = every write path returns 503. Reads unaffected.
# Reusing gsl-mou-system's token for Phase 1 is acceptable; scope tighter
# before any non-Anish staff touches this.
GSL_QUEUE_GITHUB_TOKEN=github_pat_fill_me_in

# HMAC signing key, 32 bytes hex. Generate:  openssl rand -hex 32
# Signs candidate magic links AND candidate session cookies AND (future) any
# read-only snapshot URLs. 180-day rotation. Rotating invalidates all
# outstanding magic links and active candidate sessions simultaneously.
GSL_SNAPSHOT_SIGNING_KEY=fill_me_in_64_hex_chars

# JWT signing key for staff sessions, 32 bytes hex. Generate:  openssl rand -hex 32
# Separate from the HMAC key so staff auth and candidate auth have
# independent blast radii if one is compromised. 180-day rotation.
GSL_JWT_SECRET=fill_me_in_64_hex_chars

# Transactional email provider for magic links + offer notifications.
# Resend free tier covers Phase 1 volume (100/day). Upgrade trigger: > 80/day
# sustained. Obtain at https://resend.com/api-keys — restrict to sending domain.
RESEND_API_KEY=re_fill_me_in

# Email sender address. Must match a verified sending domain in Resend.
# Default sender for magic links + offer notifications.
GSL_EMAIL_FROM=no-reply@gsl.edu.in

# Self-hosted sync runner — path to the HR Excel source on OneDrive.
# Windows path; the runner service runs on Anish's laptop where OneDrive
# desktop client has already synced this file. NOT needed locally on other
# machines (sync runs on Anish's laptop only).
GSL_HR_XLSX_PATH=C:\Users\anish\OneDrive - MAF TECHNOLOGIES PRIVATE LIMITED\GSL HR system\Hiring_Status_Q1.xlsx
